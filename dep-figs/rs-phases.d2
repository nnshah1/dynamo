...@_style
# render with D2_LAYOUT=elk (dagre folds the third panel sideways)

direction: down

c1: "Phase C1  (#17599)  built-in mesh" {
  class: host
  direction: right
  a: "GF A\ncore" {class: core}
  b: "GF B\ncore" {class: core}
  a <-> b: "ZMQ PUB/SUB :5600\n--replica-sync-port · --peer tcp://…\ntopics slot-tracker · session-affinity" {class: sync}
  n: "proof of behaviour: second port,\ncrate-internal wire format, no auth" {class: note}
}

c2: "Phase C2  gRPC ReplicaSync" {
  class: host
  direction: right
  a: "GF A\ncore + ReplicaSync server" {class: core}
  b: "GF B\ncore + ReplicaSync server" {class: core}
  gd: "Global Discovery\nGET /routers" {class: ext}
  a <-> b: "SubscribeReplicaEvents\nsnapshot frame, then batches\nsame HTTP/2 port as the API" {class: sync}
  gd -> a: "peer list" {class: signal}
  gd -> b: "peer list" {class: signal}
  n: "shippable: one port, proto in\nlib/global-common, mTLS as the relay client" {class: note}
}

later: "Later  store as transport and state" {
  class: host
  style.stroke-dash: 4
  direction: right
  a: "GF A\ncore" {class: core}
  b: "GF B\ncore" {class: core}
  s: "Redis Streams / DynamoDB Streams\nmailbox per replica: add · prefill-complete · free · binding\nstate: session rows, open-booking sets, heartbeat TTL" {class: ext}
  a -> s: "append to mailbox A\nconditional put" {class: sync}
  s -> a: "tail mailbox B\nread state at join" {class: sync}
  b -> s: "append to mailbox B\nconditional put" {class: sync}
  s -> b: "tail mailbox A\nread state at join" {class: sync}
  n: "transparent to the core: one more HostReplicaSyncFactory,\nsame events in and out; no replica-to-replica connection,\nno peer discovery; lease = heartbeat TTL" {class: note}
}

c1 -> c2 -> later: "" {class: flow}
k: "lib/kv-router unchanged in every phase: the core sees HostReplicaChannels, never the transport" {class: note}
