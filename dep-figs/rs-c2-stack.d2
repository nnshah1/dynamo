...@_style

direction: right

r1: "R1  #17665\nreplica sync protocol" {
  class: core
  l: "lib/global-common\nreplica_sync.proto + codegen\nbindings · in-flight counts\nwire ⇄ core conversions + tests" {class: plugin}
  d: "no runtime change" {class: note}
}
r2: "R2  #17669\nreplica sync over gRPC" {
  class: core
  l: "stream served on the API port\npeers: --peer, Global Discovery /routers\nbindings and in-flight counts both ways\ntwo-replica tests" {class: plugin}
  d: "off unless --replica-sync" {class: note}
}
later: "Later" {
  class: legacy
  l: "TLS with the Relay client\njoin snapshot (core export)\nstore as transport (optional)" {class: legacy}
}

r1 -> r2 -> later {class: flow}
k: "on P2 (#17598); lib/kv-router unchanged" {class: note}
