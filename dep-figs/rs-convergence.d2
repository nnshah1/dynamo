...@_style

shape: sequence_diagram

client: "Client\nsession s1" {class: ext}
a: "Global Frontend A" {class: host}
b: "Global Frontend B" {class: host}
blue: "pool blue" {class: ext}

client -> a: "turn 1, session s1"
a."picker: least full nearest pool → blue\npin s1 → blue (the core books once to bind it)"
a -> blue: "forward"
a -> b: "AffinityBinding {s1 → blue, seq 1, writer A}" {class: sync}
b."session table: s1 → blue (Inserted)"
a -> b: "InflightCount {blue: 1}  (every 100 ms)" {class: sync}

client -> b: "turn 2, session s1  (load balancer picks B)"
b."affinity_target(s1) = blue → stays on blue\n(no re-pin, KV reuse kept; no booking)"
b -> blue: "forward"
b -> a: "InflightCount {blue: 1}  (every 100 ms)" {class: sync}
a."own echoes ignored by writer id; a newer pin wins by AffinityVersion"
