vars: {
  d2-config: {
    sketch: true
    layout-engine: elk
    theme-id: 0
    pad: 24
  }
}

classes: {
  host: {
    style: {
      stroke: "#1f3a5f"
      fill: "#f6f9fd"
      stroke-width: 2
      border-radius: 10
      font-size: 18
      bold: true
    }
  }
  core: {
    style: {
      stroke: "#76b900"
      fill: "#f3fae6"
      stroke-width: 2
      border-radius: 10
      font-size: 16
    }
  }
  state: {
    style: {
      stroke: "#8a6d00"
      fill: "#fff8dc"
      stroke-width: 2
      border-radius: 6
      font-size: 14
    }
  }
  legacy: {
    style: {
      stroke: "#a33"
      fill: "#fdf0f0"
      stroke-width: 2
      stroke-dash: 4
      border-radius: 6
      font-size: 14
    }
  }
  ext: {
    style: {
      stroke: "#555"
      fill: "#f4f4f4"
      stroke-width: 2
      border-radius: 6
      font-size: 14
    }
  }
  plugin: {
    style: {
      stroke: "#4a2a8a"
      fill: "#f3eefc"
      stroke-width: 2
      border-radius: 6
      font-size: 14
    }
  }
  note: {
    shape: text
    style: {
      font-size: 14
      italic: true
    }
  }
  flow: {
    style: {
      stroke: "#1f3a5f"
      stroke-width: 2
      font-size: 13
    }
  }
  signal: {
    style: {
      stroke: "#8a6d00"
      stroke-width: 2
      stroke-dash: 5
      font-size: 13
    }
  }
  sync: {
    style: {
      stroke: "#76b900"
      stroke-width: 3
      font-size: 13
    }
  }
  no: {
    style: {
      stroke: "#a33"
      stroke-width: 2
      stroke-dash: 2
      font-size: 13
    }
  }
}
