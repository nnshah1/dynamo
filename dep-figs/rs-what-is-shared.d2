...@_style

direction: right

a: "Global Frontend A" {
  class: host
  counts: "FrontendSignals\nrequests in flight per pool" {class: state}
  core: "embedded router core" {
    class: core
    sessions: "session table\nsession → pool" {class: state}
  }
  signals: "PoolSignals\nRelay load (local view)" {class: ext}
}

b: "Global Frontend B" {
  class: host
  counts: "FrontendSignals\nrequests in flight per pool" {class: state}
  core: "embedded router core" {
    class: core
    sessions: "session table\nsession → pool" {class: state}
  }
  signals: "PoolSignals\nRelay load (local view)" {class: ext}
}

a.counts <-> b.counts: "InflightCount\nevery 100 ms" {class: sync}
a.core.sessions <-> b.core.sessions: "AffinityBinding\nlast writer wins by AffinityVersion" {class: sync}

relays: "PoolRelays" {class: ext}
relays -> a.signals: "serving load, KV" {class: signal}
relays -> b.signals: "serving load, KV" {class: signal}

a.signals -> b.signals: "load is never replicated" {class: no}

legend: "shared: in-flight counts (least-in-flight)\nand session bindings (affinity)\nnot shared: Relay load, bookings\nbest effort, bounded, off the request path" {class: note}
