...@_style

shape: sequence_diagram

client: "Client" {class: ext}
proxy: "Global Frontend\nproxy" {class: host}
sel: "CoreSelector\n(PoolSelector)" {class: plugin}
core: "router core\npicker plugins · session table" {class: core}
pool: "Pool frontend\n(selected pool)" {class: ext}

client -> proxy: "POST /v1/chat/completions\nx-dynamo-session-id: s1"
proxy -> sel: "select(request, candidate pools)"
sel -> core: "select (books nothing)\naffinity only: select_and_reserve for a new, moved or old pin" {class: flow}
core."the core runs the policy's picker plugin:\nround-robin · least-in-flight · headroom (affinity, with the session's pin)"
core -> sel: "pool" {class: flow}
sel -> proxy: "Selection { pool, in-flight count, pin booking if any }" {class: flow}
proxy -> pool: "forward bytes unchanged"
pool -> proxy: "… stream ends / client leaves"
proxy."drop the Selection: in-flight count −1;\na pin booking is freed (background)"
