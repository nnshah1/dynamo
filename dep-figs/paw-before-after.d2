...@_style

direction: down

before: "Before (#17524): routing state lives in the frontend, once per replica" {
  class: host
  style.fill: "#fdf6f6"
  style.stroke: "#a33"
  grid-columns: 3
  grid-gap: 40
  a: "Global Frontend A" {
    class: host
    sel: "PoolSelector" {class: legacy}
    cnt: "in-flight counts" {class: legacy}
    pins: "session pins" {class: legacy}
    sel -> cnt {class: no}
    sel -> pins {class: no}
  }
  n: "✕  nothing shared\ntwo ledgers, two pin maps" {class: note}
  b: "Global Frontend B" {
    class: host
    sel: "PoolSelector" {class: legacy}
    cnt: "its own counts" {class: legacy}
    pins: "its own pins" {class: legacy}
    sel -> cnt {class: no}
    sel -> pins {class: no}
  }
}

after: "After (--selection core): routing state lives in the router core the frontend embeds" {
  class: host
  grid-columns: 3
  grid-gap: 40
  a: "Global Frontend A" {
    class: host
    core: "router core\nledger · session table · picker" {class: core}
  }
  n: "⟷  bookings + pins replicate\n(companion DEP #17639)" {class: note; style.font-color: "#5a8f00"}
  b: "Global Frontend B" {
    class: host
    core: "router core\nledger · session table · picker" {class: core}
  }
}

before -> after: "" {style.opacity: 0}
k: "pools are the core's workers · policies are its picker plugins · lib/kv-router unchanged" {class: note}
after -> k: "" {style.opacity: 0}
