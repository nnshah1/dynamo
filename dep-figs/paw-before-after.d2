...@_style

direction: down

before: "Before (#17524): each Global Frontend keeps its own routing state" {
  class: host
  style.fill: "#fdf6f6"
  style.stroke: "#a33"

  gf: "Global Frontend" {
    class: host
    sel: "PoolSelector\nround-robin · least-in-flight · affinity" {class: legacy}
    inflight: "InFlightTracker\n(this process only)" {class: legacy}
    pins: "session pins\n(this process only)" {class: legacy}
    sel -> inflight: counts {class: no}
    sel -> pins: pins {class: no}
  }
  gf2: "Global Frontend (replica 2)" {
    class: host
    sel: "PoolSelector" {class: legacy}
    inflight: "its own counts" {class: legacy}
    pins: "its own pins" {class: legacy}
    sel -> inflight {class: no}
    sel -> pins {class: no}
  }
  n: "two replicas = two ledgers, two pin maps,\nnothing shared" {class: note}
}

after: "After (--selection core): pools are workers of an embedded router core" {
  class: host

  gf: "Global Frontend" {
    class: host
    adapters: "adapters  (lib/global-router/src/core)" {
      class: core
      catalog: "PoolCatalogSource\npool → worker" {class: plugin}
      selector: "CoreSelector\nbook · prefill-complete · free" {class: plugin}
      pickers: "pickers\nRoundRobin · LeastRequests · Headroom" {class: plugin}
    }
    core: "router core  (dynamo-kv-router, unchanged)" {
      class: core
      ledger: "request ledger\nper pool" {class: state}
      sessions: "session table\nsoft affinity, TTL" {class: state}
      registry: "plugin registry" {class: state}
    }
    adapters.catalog -> core: "worker set" {class: flow}
    adapters.selector -> core.ledger: "select_and_reserve" {class: flow}
    adapters.pickers -> core.registry: "register_worker_selection" {class: flow}
    core.sessions -> adapters.pickers: "affinity_target()" {class: flow}
  }
  n: "same core the frontend embeds;\nledger + session table replicate\n(companion DEP)" {class: note}
}

before -> after: "" {style.opacity: 0}

relays: "PoolRelays\noccupancy per pool" {class: ext}
pools: "Pools\nblue · green · tokyo …" {class: ext}

relays -> before.gf.sel: "slots, KV" {class: signal}
relays -> after.gf.adapters.pickers: "slots, KV\n(PoolSignals, side table)" {class: signal}
pools -> relays: "load reports" {class: signal}
after.gf.adapters.catalog -> pools: "mirrors the\npool catalog" {class: flow}
