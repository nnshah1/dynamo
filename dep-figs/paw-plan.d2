...@_style

direction: right

a: "A  #17597\nembed the core" {
  class: core
  l: "PoolCatalogSource · CoreSelector\nRequestSelector seam · --selection\nRoundRobinPicker · LeastRequestsPicker" {class: plugin}
  d: "default: legacy (unchanged)" {class: note}
}
b: "B  #17598\naffinity on the core" {
  class: core
  l: "HeadroomPicker · PoolDirectory\nsoft session table (idle TTL)" {class: plugin}
  d: "default: legacy (unchanged)" {class: note}
}
c: "C1  #17599\nreplica sync, built-in mesh" {
  class: core
  l: "--replica-sync-port · --peer tcp://\nbookings + pins shared" {class: plugin}
  d: "sync only when peers given" {class: note}
}
c2: "C2  gRPC ReplicaSync\n(three PRs, DEP #17639)" {
  class: core
  l: "C2a proto + codegen\nC2b server beside HTTP + host transport\nC2c peers from Global Discovery" {class: plugin}
  d: "one port, mTLS-ready; C1 flags retired" {class: note}
}
d: "D  cutover" {
  class: legacy
  l: "core the only path\ndelete InFlightTracker, AffinitySelector,\nLeastInFlight/RoundRobin selectors" {class: legacy}
  d: "default flips" {class: note}
}

a -> b -> c -> c2 -> d {class: flow}

k: "lib/kv-router: no change in any PR" {class: note}
