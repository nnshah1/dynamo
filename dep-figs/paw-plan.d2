...@_style

direction: right

p1: "P1  #17597\npools as core workers" {
  class: core
  l: "round-robin · least-in-flight\nas core plugins\n--use-selection-core" {class: plugin}
  d: "default: current (unchanged)" {class: note}
}
p2: "P2  #17598\naffinity on the core" {
  class: core
  l: "HeadroomPicker\nsoft session table\nbooks only for pins" {class: plugin}
  d: "default: current (unchanged)" {class: note}
}
r1: "R1  #17665\nreplica sync protocol" {
  class: core
  l: "replica_sync.proto\nbindings · in-flight counts" {class: plugin}
  d: "no runtime change" {class: note}
}
r2: "R2  #17669\nreplica sync over gRPC" {
  class: core
  l: "stream on the API port\npeers: --peer, Global Discovery" {class: plugin}
  d: "off unless --replica-sync" {class: note}
}
later: "Later: cutover" {
  class: legacy
  l: "after the A/B results:\ncore the default, then the only path" {class: legacy}
}

p1 -> p2 -> r1 -> r2 -> later {class: flow}

k: "lib/kv-router: no change in any PR" {class: note}
