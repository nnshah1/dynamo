...@_style

direction: right

gf: "Global Frontend (one replica)" {
  class: host
  direction: right
  pool: "a pool\nregion/namespace/deployment\nserves one model" {class: ext}
  req: "a request\nPOST /v1/chat/completions" {class: ext}
  sess: "a session\nx-dynamo-session-id" {class: ext}
  pol: "a policy\nround-robin · least-in-flight · affinity" {class: ext}
}

core: "embedded router core (dynamo-kv-router, unchanged)" {
  class: core
  direction: right
  worker: "a worker\nid = xxh3(pool id)" {class: state}
  booking: "a booking in the ledger, by policy:\nround-robin: never\nleast-in-flight: never\naffinity: to set, move or refresh a pin" {class: state}
  pin: "a binding in the session table\nsession → worker, soft, idle TTL" {class: state}
  picker: "a WorkerPicker plugin\nRoundRobin · LeastInFlight · Headroom" {class: plugin}
}

gf.pool -> core.worker: "is a" {class: flow}
gf.count: "an in-flight count per pool\n(FrontendSignals, shared by replica sync)" {class: state}
gf.req -> gf.count: "is counted as" {class: flow}
gf.req -> core.booking: "if its policy books" {class: flow}
gf.sess -> core.pin: "becomes a" {class: flow}
gf.pol -> core.picker: "is a" {class: flow}

relay: "outside the core:\nPoolRelay load (slots, KV) → Headroom picker\nfrontends' in-flight counts → LeastInFlight picker" {class: note}
relay -> core.picker {class: signal}
gf.count -> core.picker {class: signal}
